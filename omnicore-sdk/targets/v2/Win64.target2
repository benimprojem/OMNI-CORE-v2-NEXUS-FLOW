[target_info]
schema_major = 2
profile_id = "Win64"
profile_kind = "family"
os = "windows"
runtime = "windows"
package_format = "pe"
abi = "ms_x64"
binary_format = "pe"
entry_point = "WinMain"
stack_alignment_bytes = 16
page_size_bytes = 4096

[cpu]
id = "cpu0"
kind = "cpu"
vendor = "generic"
model = "x86_64-compatible"
architecture = "x86_64"
isa_profile = "x86-64+avx512"
core_count = 0
word_size_bits = 64
address_size_bits = 64
endian = "little"
general_register_count = 16
vector_register_count = 32
predicate_register_count = 8
vector_width_bits = 512
atomic_widths = 8,16,32,64
fp_formats = fp32,fp64
features = atomics,unaligned_access,hardware_float,hardware_divide,privilege_levels,vector
isa_extensions = sse,sse2,sse3,ssse3,sse4.1,sse4.2,avx,avx2,avx512f