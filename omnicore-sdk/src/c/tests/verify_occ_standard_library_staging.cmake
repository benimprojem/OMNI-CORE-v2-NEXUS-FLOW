if(NOT DEFINED OCC_PACKAGE_DIR)
    message(FATAL_ERROR "OCC_PACKAGE_DIR was not provided")
endif()

set(_occ_config "${OCC_PACKAGE_DIR}/occ.ocf")
set(_osmodule "${OCC_PACKAGE_DIR}/libs/osmodule.nxf")
set(_coremodule "${OCC_PACKAGE_DIR}/libs/coremodule.nxf")
set(_dsplibs "${OCC_PACKAGE_DIR}/dsplibs/README.md")
set(_targets "${OCC_PACKAGE_DIR}/targets")
set(_lang "${OCC_PACKAGE_DIR}/lang")

foreach(_required IN ITEMS "${_occ_config}" "${_osmodule}" "${_coremodule}" "${_dsplibs}" "${_targets}" "${_lang}")
    if(NOT EXISTS "${_required}")
        message(FATAL_ERROR "Required OCC package asset is missing: ${_required}")
    endif()
endforeach()

file(READ "${_occ_config}" _config_text)
string(FIND "${_config_text}" "./libs" _libs_index)
if(_libs_index EQUAL -1)
    message(FATAL_ERROR "Packaged occ.ocf must include ./libs")
endif()

file(READ "${_osmodule}" _osmodule_text)
file(READ "${_coremodule}" _coremodule_text)
if(NOT _osmodule_text MATCHES "osmodule\\.nxf")
    message(FATAL_ERROR "osmodule.nxf starter file header is invalid")
endif()
if(NOT _coremodule_text MATCHES "coremodule\\.nxf")
    message(FATAL_ERROR "coremodule.nxf starter file header is invalid")
endif()
