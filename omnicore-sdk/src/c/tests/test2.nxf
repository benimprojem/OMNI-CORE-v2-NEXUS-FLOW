# OmniCore v2 - Test 2: Döngüler ve Akış

f:main() {
    v:counter = 0;

    # 1. Infinite Loop
    (loop){
        counter = counter + 1;
        ?>(cikis); # Jump ile çıkış
    }
    cikis:>

    # 2. While Loop 
    loop(counter < 10){
        counter = counter + 1;
    }

    # 3. For Loop 
    v:i = 0;
    loop(i, i < 5, i = i + 1){
        counter = counter + 2;
    }
    
    # 4. For Loop
    loop(v:k = 0, k < 3, k = k + 1){
        counter = counter + k;
    }
    
    # 5. For Loop
    loop(j, j < 5, j++){
        counter = counter + j;
    }
    
    # 6. Range Loop
    loop(1..10){ 
       v:a = (it); 
    }
}